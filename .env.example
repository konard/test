APP_NAME="Антикоррупционный мониторинг"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=anticorruption
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAX_UPLOAD_SIZE=64M

# Anonymization salt - generate with: php -r "echo bin2hex(random_bytes(32));"
ANON_SALT=

# Audit logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=audit.log
